<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    >

    <TextView
        android:id="@+id/pantalla"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:background="@color/pantalla"
        android:gravity="end|bottom"
        android:padding="16dp"
        android:text="@string/nombreCompleto"
        android:textSize="32sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/b7"
        style="@style/btnCalculator"
        android:text="7"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/pantalla"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/b8"
        app:layout_constraintBottom_toTopOf="@id/b4"
        />

    <Button
        android:id="@+id/b8"
        android:text="8"
        style="@style/btnCalculator"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toBottomOf="@id/b7"
        app:layout_constraintStart_toEndOf="@id/b7"
        app:layout_constraintEnd_toStartOf="@id/b9"
        app:layout_constraintTop_toTopOf="@id/b7"
        />

    <Button
        android:id="@+id/b9"
        android:text="9"
        style="@style/btnCalculator"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toBottomOf="@id/b7"
        app:layout_constraintStart_toEndOf="@id/b8"
        app:layout_constraintEnd_toStartOf="@id/bPor"
        app:layout_constraintTop_toTopOf="@id/b7"
        />

    <Button
        android:id="@+id/bPor"
        android:text="x"
        style="@style/btnCalculator"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toBottomOf="@id/b7"
        app:layout_constraintStart_toEndOf="@id/b9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/b7"
        />

    <Button
        android:id="@+id/b4"
        android:text="4"
        style="@style/btnCalculator"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/b7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/b5"
        app:layout_constraintBottom_toTopOf="@id/b1"
        />

    <Button
        android:id="@+id/b5"
        android:text="5"
        style="@style/btnCalculator"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toBottomOf="@id/b4"
        app:layout_constraintStart_toEndOf="@id/b4"
        app:layout_constraintEnd_toStartOf="@id/b6"
        app:layout_constraintTop_toTopOf="@id/b4"
        />

    <Button
        android:id="@+id/b6"
        android:text="6"
        style="@style/btnCalculator"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toBottomOf="@id/b4"
        app:layout_constraintStart_toEndOf="@id/b5"
        app:layout_constraintEnd_toStartOf="@id/bMenos"
        app:layout_constraintTop_toTopOf="@id/b4"
        />

    <Button
        android:id="@+id/bMenos"
        android:text="-"
        style="@style/btnCalculator"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toBottomOf="@id/b4"
        app:layout_constraintStart_toEndOf="@id/b6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/b4"
        />

    <Button
        android:id="@+id/b1"
        android:text="1"
        style="@style/btnCalculator"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/b4"
        app:layout_constraintBottom_toTopOf="@id/bComa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/b2"
        />

    <Button
        android:id="@+id/b2"
        android:text="2"
        style="@style/btnCalculator"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toBottomOf="@id/b1"
        app:layout_constraintStart_toEndOf="@id/b1"
        app:layout_constraintEnd_toStartOf="@id/b3"
        app:layout_constraintTop_toTopOf="@id/b1"
        />

    <Button
        android:id="@+id/b3"
        android:text="3"
        style="@style/btnCalculator"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toBottomOf="@id/b1"
        app:layout_constraintStart_toEndOf="@id/b2"
        app:layout_constraintEnd_toStartOf="@id/bMas"
        app:layout_constraintTop_toTopOf="@id/b1"
        />

    <Button
        android:id="@+id/bMas"
        android:text="+"
        style="@style/btnCalculator"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toBottomOf="@id/b1"
        app:layout_constraintStart_toEndOf="@id/b3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/b1"
        />

    <Button
        android:id="@+id/bComa"
        android:text=","
        style="@style/btnCalculator"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toBottomOf="@id/b1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/b0"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <Button
        android:id="@+id/b0"
        android:text="0"
        style="@style/btnCalculator"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintBottom_toBottomOf="@id/bComa"
        app:layout_constraintStart_toEndOf="@id/bComa"
        app:layout_constraintEnd_toStartOf="@id/bIgual"
        app:layout_constraintTop_toTopOf="@id/bComa"
        />

    <Button
        android:id="@+id/bIgual"
        android:text="="
        style="@style/btnCalculator"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintBottom_toBottomOf="@id/bComa"
        app:layout_constraintStart_toEndOf="@id/b0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/bComa"
        />
</androidx.constraintlayout.widget.ConstraintLayout>